# Портал 2.2 · боевой portal.getsestate.com — шаблон окружения. Значения не коммитить.
# На сервере: /opt/getsestate/env/portal22.env, root:getsestate 640 (как у v1).
# Все секреты новые, не со стенда.
DATABASE_URL=postgres://portal_app:<пароль>@127.0.0.1:5432/portal  # роль portal_app — на неё гранты в catalog-v2.sql и миграциях
SESSION_SECRET=<openssl rand -hex 32>
PUBLIC_URL=https://portal.getsestate.com
FILES_DIR=/opt/getsestate/portal22/files      # свой, у v1 отдельный
UPLOADS_DIR=<каталог загрузок v1>             # общий с v1: листы планировок из directus_files
# Заявки с сайтов (getsestate.com/.de/.co.il): свой секрет, источники — боевые домены
LEADS_SECRET=<openssl rand -hex 24>
LEADS_ORIGINS=https://getsestate.com,https://www.getsestate.com,https://getsestate.de,https://getsestate.co.il
# Почта: noreply@ — пароль вводит Денис, сюда его не переносим из Word
SMTP_URL=smtps://noreply%40getsestate.com:<пароль>@smtp.gmail.com:465
SMTP_FROM=GetsEstate <noreply@getsestate.com>
# Bitrix24: новый вебхук или ключ боевого приложения (старый вебхук стенда перевыпустить), домен — только боевой портал
B24_WEBHOOK=https://getsestate.bitrix24.ae/rest/<id>/<ключ>
B24_DOMAINS=getsestate.bitrix24.ae
# На бою ВЫКЛЮЧЕНО — строки не ставить совсем:
#   QA_MODE (вход /dev/login, черновой язык /dev/lang)
#   ALLOW_IMPERSONATE_WRITE (запись «от имени»)
#   PB_KEY_MOCK / PB_MOCK_KEY (заглушка Profitbase)
#   I18N_DUMP
